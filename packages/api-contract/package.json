      "optional": true
    }
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@itera/domain": "workspace:*",
    "@redocly/cli": "2.57.0",
    "@tanstack/react-query": "5.104.1",
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
