{
  "name": "@itera/api-contract",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./create-client": "./src/create-client.ts",
    "./problems": "./src/problems.ts",
    "./react-query": "./src/react-query.ts",
    "./requests": "./src/requests.ts",
    "./sending": "./src/sending.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
