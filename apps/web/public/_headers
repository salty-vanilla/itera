# Read by Workers Static Assets (services/api/wrangler.jsonc). Vite copies
# this file from public/ to the root of dist/.
#
# Without a rule Workers sends `max-age=0, must-revalidate` for every asset.
# Files under /assets/ have a content hash in their name (Vite's default), so
# a changed file gets a new URL and these can be cached for good. index.html
# keeps the default, so a new deployment is picked up on the next load.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
