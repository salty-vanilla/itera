# Copy to .dev.vars (ignored by Git) for `pnpm dev`. Never commit real values.
# Signs cookies and encrypts stored Google tokens. At least 32 characters;
# generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The origin the browser sees (Web and API are served from it together).
# Passkeys are bound to its host name, so `localhost` works for local use.
BETTER_AUTH_URL=http://localhost:8787
# Google OAuth client (Google Cloud Console, type "Web application"). Its
# authorized redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google.
# Without a client, put any non-empty placeholder: everything but the Google
# round trip still works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email addresses that may sign up, separated by commas. Signing in with a
# Google account outside the list fails without creating a user. Required:
# when empty, requests that use auth fail with 500.
SIGN_UP_ALLOWED_EMAILS=
