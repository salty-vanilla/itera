{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itera-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  // Served at <name>.<subdomain>.workers.dev until a custom domain is chosen
  // (docs/operations/deploy.md). Preview URLs stay off: they would publish
  // every uploaded version at its own URL.
  "workers_dev": true,
  "preview_urls": false,
  // The Web app is served from the same Worker, so the cookie and CORS
  // assumptions of ADR 0004 stay as they are. Build it first
  // (`pnpm --filter @itera/web build`): wrangler fails when the directory is
  // missing. Paths that match no file get index.html (the router renders the
  // screen or "not found"), and only /api/* reaches the Worker code.
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  // Better Auth settings come from .dev.vars locally and from `wrangler secret`
  // when deployed. Never put their values here (see .dev.vars.example).
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SIGN_UP_ALLOWED_EMAILS",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "itera",
      // Placeholder until the D1 database is created (docs/operations/deploy.md, step 2).
      // Local development (`wrangler dev`, `--local`) does not use it.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
