{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableSkillShellExecution": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-env.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.mjs",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm agent:check)",
      "Bash(pnpm agent:doctor)",
      "Bash(pnpm agent:hooks:test)",
      "Bash(pnpm design:lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm check)",
      "Bash(pnpm agent:playwright snapshot *)",
      "Bash(pnpm agent:playwright screenshot *)",
      "Bash(pnpm agent:shadcn info *)",
      "Bash(pnpm agent:shadcn view *)",
      "Bash(pnpm agent:shadcn search *)",
      "Bash(pnpm agent:shadcn docs *)",
      "Bash(pnpm agent:impeccable context *)",
      "Bash(node .agents/skills/design-references/scripts/hig.mjs *)",
      "Bash(pnpm copy:list)",
      "Bash(pnpm copy:list *)",
      "Bash(node .agents/skills/copy-review/scripts/tally.mjs *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "WebFetch(domain:design.digital.go.jp)",
      "WebFetch(domain:developer.apple.com)",
      "WebFetch(domain:github.com)"
    ],
    "ask": [
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(pnpm agent:shadcn add *)",
      "Bash(pnpm agent:playwright run-code *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpx *)",
      "Bash(bunx *)",
      "Bash(playwright-cli *)",
      "Bash(pnpm agent:playwright open *)",
      "Bash(pnpm agent:playwright goto *)"
    ],
    "deny": [
      "Bash(npx shadcn@latest *)",
      "Bash(npx wrangler *)",
      "Bash(npx hono *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.dev.vars)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(cat *.env.*.local)"
    ]
  }
}
