# shellcheck shell=bash
#
# direnv configuration shared by this repository and its Git worktrees.
# Orca runs `direnv allow .` before tooling/setup.sh, so anything exported here
# is already in place when setup and tooling/with-node.sh run.

# Load this checkout's local variables; an absent file is OK.
# Untracked files such as .env.local do not follow `git worktree add`, so read
# the main worktree's copy first and let this worktree override it.
if git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null)"; then
  main_worktree="$(cd "${git_common_dir}/.." && pwd)"
  if [[ "$main_worktree" != "$PWD" ]]; then
    dotenv_if_exists "$main_worktree/.env.local"
    watch_file "$main_worktree/.env.local"
  fi
fi
dotenv_if_exists .env.local

# Select this repository's pinned Node and pnpm from devbox.lock. Both guards are
# deliberate: the devbox test keeps checkouts without Devbox usable, and the
# devbox.json test keeps branches predating this file usable. `--install`
# restores missing packages, so a new worktree needs no extra step and reuses the
# machine-wide Nix store. An explicitly supplied ITERA_NODE_BIN still wins, and
# ITERA_SKIP_DEVBOX=1 falls back to the host toolchain.
if [[ -z "${ITERA_SKIP_DEVBOX:-}" && -z "${ITERA_NODE_BIN:-}" ]] &&
  has devbox && [[ -f devbox.json ]]; then
  eval "$(devbox shellenv --init-hook --install --no-refresh-alias)"
  watch_file devbox.json devbox.lock
fi

# pnpm must run on the Node selected above: engines checks -- this package's and
# its dependencies' -- are evaluated against the interpreter that runs pnpm, not
# against PATH. Node no longer bundles Corepack, and the Nix Corepack writes its
# own Node into the shim's shebang, so install the version package.json already
# names with this checkout's npm. npm writes `#!/usr/bin/env node`, which follows
# PATH. Devbox's Node prefix is read-only, so this lives inside the checkout and
# is reinstalled only when the pinned version changes.
# An explicit ITERA_NODE_BIN selects the Node (and npm) used below and later.
if [[ -n "${ITERA_NODE_BIN:-}" ]]; then
  PATH_add "$ITERA_NODE_BIN"
fi

if [[ -z "${ITERA_SKIP_DEVBOX:-}" ]] && [[ -f devbox.json ]] && has npm; then
  pnpm_home="$PWD/.devbox/pnpm"
  pnpm_version="$(sed -n 's/.*"packageManager": *"pnpm@\([0-9.]*\)".*/\1/p' package.json)"
  if [[ -n "$pnpm_version" && "$("$pnpm_home/bin/pnpm" --version 2>/dev/null)" != "$pnpm_version" ]]; then
    log_status "Installing pnpm $pnpm_version for this checkout"
    npm install --global --prefix "$pnpm_home" --no-fund --no-audit --loglevel error "pnpm@$pnpm_version"
  fi
  PATH_add "$pnpm_home/bin"
fi

# Prefer this checkout's binaries over globals. Kept after Devbox and Corepack so
# that node_modules/.bin wins over both.
PATH_add node_modules/.bin

